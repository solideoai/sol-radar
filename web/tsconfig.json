{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@test-harness/local-test-target.mjs": ["../scripts/local-test-target.mjs"],
      "@test-harness/supabase-pglite.mjs": ["../scripts/supabase-pglite.mjs"],
      "@test-harness/demo-plan.mjs": ["../scripts/demo/plan.mjs"],
      "@test-harness/demo-bid-notices.mjs": ["../scripts/demo/bid-notices.mjs"],
      "@test-harness/people-seed.mjs": ["../scripts/people/seed.mjs"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
