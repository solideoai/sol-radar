{
  "name": "sol-radar-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "verify": "pnpm format:check && pnpm type-check && pnpm lint && pnpm check:lint-guards && pnpm test && pnpm lodestar && pnpm check:tokens && pnpm check:colors && pnpm build",
    "test": "vitest run",
    "lodestar": "lodestar check",
    "check:colors": "bash ../scripts/check-colors.sh",
    "check:lint-guards": "node ../scripts/check-lint-guards.mjs",
    "check:tokens": "node ../scripts/tokens-gen.mjs --check",
    "verify:quick": "pnpm format:check && pnpm type-check && pnpm lint && pnpm check:lint-guards && pnpm test && pnpm lodestar && pnpm check:tokens && pnpm check:colors",
    "test:e2e": "playwright test && pnpm test:browser",
    "test:e2e:auth": "node ../scripts/db-seed.mjs && playwright test -c playwright.auth.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "worker": "node --conditions=react-server --import tsx worker/main.ts",
    "worker:check": "node --conditions=react-server --import tsx worker/main.ts --check",
    "worker:ping": "node --conditions=react-server --import tsx worker/ping.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^6.3.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@retemper/lodestar": "^0.0.6",
    "@retemper/lodestar-plugin-architecture": "^0.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
