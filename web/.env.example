# 웹이 쓰는 값. 이 파일을 복사해 web/.env.local 을 만들고 값을 채우세요.
#
#   cp web/.env.example web/.env.local
#
# Supabase 프로젝트를 만든 뒤 채웁니다(database 스킬 참고). 그전까지는 비워 둬도
# 화면이 뜹니다(템플릿 화면이 아직 DB를 읽지 않기 때문입니다).
#
# 값은 Supabase 대시보드 → Project Settings → API 에서 복사합니다.
#
# 로컬 Supabase(Docker + Supabase CLI)를 쓰면 손으로 복사하지 않습니다. 루트에서 `pnpm db:start` 를
# 돌리면 이 파일을 바탕으로 web/.env.local 을 만들고 로컬 주소(http://127.0.0.1:54321)와 로컬 anon 키를
# 적습니다. 다른 줄은 그대로 둡니다. 이미 클라우드 주소가 적혀 있으면 그 파일은 건드리지 않습니다.
#
# 실값은 .env.local 에만 둡니다. 이 파일(.env.example)에는 넣지 마세요 —
# 이 파일은 깃에 올라갑니다.

# anon 키는 브라우저에 노출되는 것이 정상입니다. 무엇을 읽고 쓸 수 있는지는
# 키가 아니라 DB의 RLS 정책이 정합니다.
# 새 API 키를 쓰는 프로젝트는 anon 키 자리에 publishable 키(sb_publishable_…)를 넣어도 됩니다. secret 키는 넣지 않습니다.
# URL 은 프로젝트 주소 그대로(https://<ref>.supabase.co) 둡니다. 서버가 로그인 토큰의 발급자(iss)를 이 주소로 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 간편 로그인 버튼을 보일지. Supabase 에 그 제공자를 설정한 뒤에만 true 로 둡니다(docs/boilerplate/OAUTH-PROVIDERS.md).
# 꺼 둔 제공자는 로그인 버튼과 마이페이지의 연결 버튼만 없고, 나머지는 그대로 동작합니다.
# 제공자의 Client ID·Secret 은 여기가 아니라 Supabase 대시보드(로컬은 supabase/.env)에 둡니다.
# NEXT_PUBLIC_AUTH_GOOGLE=true
# NEXT_PUBLIC_AUTH_KAKAO=true
# NEXT_PUBLIC_AUTH_NAVER=true

# 초대 메일(선택) — 서버 전용. 팀에 초대(다시 초대)하면 받는 사람에게 SMTP 로 메일을 보냅니다.
# SMTP_HOST·SMTP_PORT·MAIL_FROM·SITE_URL 이 모두 있어야 보냅니다. 하나라도 없으면 메일 없이 초대만 저장하고,
# 화면이 "직접 알려 주세요"라고 안내합니다. 보내지 못해도(접속 실패·10초 시간 초과) 초대는 그대로 남습니다.
# ⚠️ 접두어(NEXT_PUBLIC_)를 붙이지 마세요. 붙이면 SMTP 비밀번호가 브라우저에 노출됩니다.
#
# 로컬 Supabase 를 쓰면 손으로 적지 않습니다. `pnpm db:start` 가 메일 설정이 비어 있을 때 로컬 메일함 값
# (SMTP_HOST=127.0.0.1, SMTP_PORT=54325, MAIL_FROM, SITE_URL=http://localhost:3000)을 적고,
# 메일은 실제로 나가지 않고 메일함(http://127.0.0.1:54324)에 쌓입니다. 이미 적어 둔 메일 설정은 덮지 않습니다.
# 운영 값은 배포 서비스에 넣습니다(docs/boilerplate/first-deployment.md).
#
# SMTP 서버 주소와 포트. 465 는 처음부터 TLS, 587 은 STARTTLS 로 붙습니다.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP 로그인(비밀값). 인증 없는 서버(로컬 메일함)면 둘 다 비웁니다. 적으면 TLS 가 없을 때 보내지 않습니다.
# SMTP_USER=
# SMTP_PASSWORD=
# 보내는 주소. 이름을 붙이려면 따옴표로 감쌉니다: MAIL_FROM="서비스 이름 <no-reply@your-domain.com>"
# MAIL_FROM=no-reply@your-domain.com
# 웹 주소(끝의 / 없이). 메일의 링크가 <SITE_URL>/invitations 입니다. 운영은 실제 도메인을 적습니다.
# SITE_URL=https://your-domain.com

# service_role 키 — 서버 전용 비밀값. getSupabaseAdmin() 을 쓸 때만 채웁니다.
# ⚠️ RLS를 통째로 무시합니다. 접두어(NEXT_PUBLIC_)를 절대 붙이지 마세요. 붙이면 브라우저에 노출됩니다.
# SUPABASE_SERVICE_ROLE_KEY=

# 목록 HMAC 커서(인력·공고·분석·알림)용 서버 전용 키(32자 이상, 24시간 유효). 운영 환경에서 별도 설정.
API_CURSOR_SECRET=

# 상태 검사(/health/ready)가 보는 서버 전용 값. 접두어(NEXT_PUBLIC_)를 붙이지 마세요. 비워 두면 그 검사는 unavailable 입니다.
# Redis 주소. 비밀번호가 들어가므로 실값은 web/.env.local 에만 둡니다. Compose 가 호스트에 연 Redis 포트(기본 6380)를 씁니다.
# REDIS_URL=redis://:<비밀번호>@127.0.0.1:6380
# 비밀번호는 영숫자만 사용(예: `openssl rand -hex 32`). `/`·`@`·`:`·`#`·`"`·`\` 가 들어가면 REDIS_URL 해석과 redis 설정이 깨진다.
# MinIO 사용자는 3자 이상, 비밀번호는 8자 이상.
# MinIO(첨부 저장소) 주소
# MINIO_ENDPOINT=http://127.0.0.1:9000
# AI gateway 주소
# AI_GATEWAY_URL=http://127.0.0.1:8000
REDIS_URL=
MINIO_ENDPOINT=
AI_GATEWAY_URL=

# worker 의 분석 run 복구(선택, 1~3600000 정수 밀리초). web 이 아니라 worker 가 읽고, 이 파일(web/.env.local)은 worker 가 읽지 않는다.
# 호스트에서 띄운 worker(`pnpm -C web worker`)는 셸 환경 변수로 넘긴다. 아래는 코드의 기본값을 적어 둔 것이다.
# ANALYSIS_STALE_QUEUED_MS=600000
# ANALYSIS_STALE_RUNNING_MS=600000
# ANALYSIS_RECONCILE_INTERVAL_MS=60000

# service_role 키(SUPABASE_SERVICE_ROLE_KEY)는 web/.env.local 에 두지 않습니다. 웹 요청 경로는 로그인 세션과 RLS 만 씁니다.
# 이 키는 worker(infra/.env)와 `pnpm demo:reset`(루트 .env.local)만 읽습니다(docs/10-DEPLOYMENT.md).
