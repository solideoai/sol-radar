{
  "version": 1,
  "verification": {
    "common": [
      {
        "command": "pnpm",
        "args": ["format:check"],
        "changedPaths": [
          "^(scripts|design|fixtures|infra)/",
          "^(package\\.json|pnpm-lock\\.yaml|verify\\.config\\.json|\\.prettier.*|\\.npmrc)$"
        ]
      },
      {
        "command": "pnpm",
        "args": ["test"],
        "changedPaths": [
          "^(scripts|supabase|fixtures|design)/",
          "^infra/run-modes[.]json$",
          "^\\.husky/",
          "^\\.claude/(hooks/|settings.*\\.json$)",
          "^\\.github/",
          "^(package\\.json|pnpm-lock\\.yaml|verify\\.config\\.json|\\.npmrc)$"
        ]
      },
      {
        "command": "pnpm",
        "args": ["check:tokens"],
        "changedPaths": ["^design/", "^web/app/globals\\.css$", "^scripts/tokens-gen"]
      },
      {
        "command": "pnpm",
        "args": ["check:colors"],
        "changedPaths": ["^design/", "^scripts/check-colors\\.sh$"]
      },
      {
        "command": "pnpm",
        "args": ["check:db-types"],
        "changedPaths": [
          "^supabase/",
          "^web/lib/database\\.types\\.ts$",
          "^scripts/(db-types-gen|supabase-pglite|migrations)\\.mjs$"
        ]
      }
    ],
    "projects": [
      {
        "name": "web",
        "directory": "web",
        "marker": "package.json",
        "changedPaths": [
          "^web/",
          "^services/decision/tests/fixtures/",
          "^(supabase|design|fixtures|infra)/",
          "^scripts/(demo/|people/|run-mode\\.mjs$|local-test-target\\.|supabase-pglite\\.mjs$)",
          "^(package\\.json|pnpm-lock\\.yaml|verify\\.config\\.json|\\.prettier.*|\\.npmrc)$"
        ],
        "setup": {
          "command": "pnpm",
          "args": ["install", "--frozen-lockfile"]
        },
        "verify": {
          "command": "pnpm",
          "args": ["verify"]
        },
        "quick": {
          "command": "pnpm",
          "args": ["verify:quick"]
        },
        "prepareE2e": {
          "command": "pnpm",
          "args": ["exec", "playwright", "install", "--with-deps", "chromium"]
        },
        "e2e": {
          "command": "pnpm",
          "args": ["test:e2e"]
        }
      },
      {
        "name": "ai",
        "directory": "services/ai",
        "marker": "pyproject.toml",
        "changedPaths": [
          "^services/ai/",
          "^(fixtures|infra)/",
          "^(package\\.json|pnpm-lock\\.yaml|verify\\.config\\.json|\\.npmrc)$"
        ],
        "setup": {
          "command": "uv",
          "args": ["sync", "--frozen"]
        },
        "verify": {
          "command": "bash",
          "args": ["verify.sh"]
        },
        "quick": {
          "command": "bash",
          "args": ["verify.sh"]
        }
      },
      {
        "name": "decision",
        "directory": "services/decision",
        "marker": "pyproject.toml",
        "changedPaths": [
          "^services/decision/",
          "^services/ai/src/sol_ai/adapters/",
          "^services/ai/src/sol_ai/(registry|contracts|deadline|strict_json|errors|schema|timeutil|paths)[.]py$",
          "^services/ai/(kev/question-sets|models|schemas)/",
          "^(fixtures|infra)/",
          "^(package\\.json|pnpm-lock\\.yaml|verify\\.config\\.json|\\.npmrc)$"
        ],
        "setup": {
          "command": "uv",
          "args": ["sync", "--frozen"]
        },
        "verify": {
          "command": "bash",
          "args": ["verify.sh"]
        },
        "quick": {
          "command": "bash",
          "args": ["verify.sh"]
        }
      }
    ]
  },
  "migrationDirectories": ["supabase/migrations/"]
}
