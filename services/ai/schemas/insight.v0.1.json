{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "strengths", "improvements"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "strengths": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "refIds"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "refIds": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "pattern": "^[BC][1-9][0-9]?$" }
          }
        }
      }
    },
    "improvements": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "refIds"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "refIds": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "pattern": "^[BC][1-9][0-9]?$" }
          }
        }
      }
    }
  }
}
