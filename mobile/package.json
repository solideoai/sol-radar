{
  "name": "sol-radar-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "check:tokens": "node ../scripts/tokens-gen.mjs --check",
    "check:colors": "bash ../scripts/check-colors.sh",
    "check:lint-guards": "node ../scripts/check-lint-guards.mjs",
    "check:expo": "node ../scripts/check-expo.mjs",
    "verify": "pnpm format:check && pnpm type-check && pnpm lint && pnpm check:lint-guards && pnpm test && pnpm check:tokens && pnpm check:colors && pnpm check:expo && pnpm build",
    "verify:quick": "pnpm format:check && pnpm type-check && pnpm lint && pnpm check:lint-guards && pnpm test && pnpm check:tokens && pnpm check:colors",
    "build": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "3.9.9",
    "typescript": "~6.0.3"
  }
}
