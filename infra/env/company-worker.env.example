# infra/.env.worker.local에 복사하고 권한600으로 관리한다.
# 같은 Redis와 Supabase/버킷을 회사 API에 설정한다. 값은 로그로 출력하지 않는다.
NEXT_PUBLIC_SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
REDIS_URL=redis://CHANGE_ME@sol-radar-redis:6379
SUPABASE_STORAGE_RAW_BUCKET=bid-documents
SUPABASE_STORAGE_PARSED_BUCKET=bid-parsed
# live 수집의 서비스키는 Worker에만 추가한다. 기존 infra/env/ai-local.env.example 참조.
# SOL_RUN_MODE·AI_GATEWAY_URL·fixture/registry 경로는 Compose가 주입한다.
