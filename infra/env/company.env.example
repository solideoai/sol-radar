# docker compose --env-file infra/.env.company.local -f infra/compose.company.yaml ...
# 이 파일에는 비밀을 두지 않는다. 각 서비스의 env 파일을 별도로 준비한다.
# 기존 Redis가 붙은 사용자 정의 network 이름을 현장에서 확인한다.
# 기본 bridge만 있으면 이 예시를 실행하지 말고 연결 배치를 먼저 확인한다.
SOL_RADAR_REDIS_NETWORK=CHANGE_ME
# 현재 웹과 같은 모드. fixture/live 전환은 실제 모델·API 준비 확인 후 진행한다.
SOL_RUN_MODE=mock
