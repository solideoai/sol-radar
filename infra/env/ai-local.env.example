# SOL RADAR ai-local(live) 환경 변수 예시. 값은 placeholder(CHANGE_ME)만 둔다.
# 사용: cp infra/env/ai-local.env.example infra/.env 후 CHANGE_ME 를 실제 값으로 채운다.
#   infra/.env 는 깃에 올리지 않는다. 비밀값(키·비밀번호)은 서버 전용이고 NEXT_PUBLIC_ 변수에 넣지 않는다.
#
# 회사 GPU 의 Qwen 은 회사가 운영하는 vLLM API(https://acropolissg.com/vllm/v1 — 회사 안내 주소는 …/vllm/v1, 게이트웨이가 /v1 중복을 정규화한다(B1))로,
#   결정 모델 Bosun(KEV_* 이름은 호환 유지, ADR-034)은 회사 호스트의 sol_decision 서버(127.0.0.1:8009)로 붙는다(ADR-025).
#   회사 Compose gateway(network_mode: host)는 루프백으로 닿는다. 설계한 공개 경로 https://acropolissg.com/sol-radar/kev 는
#   회사 nginx 에 등록되지 않아(2026-10-27) 노트북에서는 결정 모델에 닿지 않는다. 루프백이 아닌 주소는 https 만 받는다.
#   TLS 인증서 검증을 끄지 않는다. 키 값은 이 파일의 사본(infra/.env)에만 둔다.
# 주의: 레지스트리 항목 bosun-v3.1-0.6b·qwen3.8-flash-next 와 결정 서버 sol_decision 은 B1 에서 구현한다. B1 검증 통과 전에는 이 값으로 live·fixture 를 기동하지 않는다(ADR-034 16번).

# 실행 모드: live. fixture 로 두면 수집만 fixture 를 쓴다(그때는 DEMO_MODE 를 확인한다).
SOL_RUN_MODE=live
DEMO_MODE=false
AI_PROVIDER=local
KEV_ENABLED=true
AI_FALLBACK_TO_MOCK=false
AI_HOSTED_APPROVED=false
KEV_ALLOW_KO_STATE=false

# 회사 운영 vLLM API. 회사 안내 주소는 https://acropolissg.com/vllm/v1 — 게이트웨이가 끝의 /v1 을 인식해 /chat/completions·/models 를 붙인다(B1 정규화. /v1 없이 적어도 동작)(2026-10-20 사용자 결정)
QWEN_BASE_URL=https://acropolissg.com/vllm/v1
# 회사 vLLM /v1/models 의 id 와 같아야 한다. 레지스트리 항목 qwen3.8-flash-next(2026-10-21 Qwen/Qwen3.5-27B 에서 교체)
QWEN_MODEL=Qwen3.8-Flash-Next-AWQ-INT4
# 회사가 제공하는 vLLM API 키(별도 환경변수). gateway 만 읽는다.
QWEN_API_KEY=CHANGE_ME
KEV_BASE_URL=http://127.0.0.1:8009
# 결정 모델 Bosun v3.1 0.6B(services/ai/models/registry.yaml 항목 → Hanno-Labs/bosun-v3.1-0.6b@5e78a37c, B1 에서 추가). KEV_* 이름은 호환 유지(ADR-034)
KEV_MODEL_ID=bosun-v3.1-0.6b
KEV_QUESTION_SET=kev-qs/v0.2
# 결정 서버(sol_decision)의 DECISION_API_KEY 와 같은 값. gateway 만 읽는다.
KEV_API_KEY=CHANGE_ME

# 조달청 API 서비스별 키 4개 (live 에서 모두 필수). worker 만 읽는다. 로그에 찍지 않는다.
# 값은 data.go.kr 포털의 Encoding 키를 그대로 넣는다. worker 가 decodeURIComponent 로 한 번 디코딩해 Decoding 키로 쓴다.
G2B_BID_NOTICE_SERVICE_KEY=CHANGE_ME
G2B_PRE_SPEC_SERVICE_KEY=CHANGE_ME
G2B_ORDER_PLAN_SERVICE_KEY=CHANGE_ME
G2B_INDUSTRY_MASTER_SERVICE_KEY=CHANGE_ME

# Supabase 클라우드 프로젝트 (공개 URL / 서버 전용 service role)
NEXT_PUBLIC_SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# 내부 서비스 비밀번호
# REDIS_PASSWORD 는 영숫자만 사용(예: `openssl rand -hex 32`). `/`·`@`·`:`·`#`·`"`·`\` 가 들어가면 REDIS_URL 해석과 redis 설정이 깨진다.
REDIS_PASSWORD=CHANGE_ME

# worker 의 fixture·소스 registry 경로(FIXTURES_DIR·SOURCES_REGISTRY_FILE)는 infra/compose.yaml 이 컨테이너 안 경로로 고정한다. 여기서 바꾸지 않는다.

# 선택: 부처 지원사업 공고(ADR-040). 기업마당·과기정통부 인증키는 live 모드에서만 쓰고, 없으면 그 출처만 건너뛴다(중기부 RSS 는 키가 없다).
# worker 만 읽는다. 로그·녹음에 찍지 않는다. 수집 간격은 1~1440분이고 없으면 60분.
# 과기정통부 키는 공공데이터포털 15074634 의 Encoding 키를 그대로 넣는다.
# BIZINFO_API_KEY=
# MSIT_ANNOUNCEMENT_API_KEY=
# PROGRAM_NOTICES_INTERVAL_MINUTES=60

# 선택: 호스트 포트가 겹칠 때만 주석을 풀어 바꾼다 (항상 127.0.0.1 에만 열린다)
# REDIS_HOST_PORT=6380
# QDRANT_HOST_PORT=6333
# AI_GATEWAY_HOST_PORT=8000

# Private Supabase Storage. Secret/service_role는 Worker/운영 CLI에만 둔다.
SUPABASE_STORAGE_RAW_BUCKET=bid-documents
SUPABASE_STORAGE_PARSED_BUCKET=bid-parsed
