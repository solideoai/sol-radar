# SOL RADAR ai-local(live) 환경 변수 예시. 값은 placeholder(CHANGE_ME)만 둔다.
# 사용: cp infra/env/ai-local.env.example infra/.env 후 CHANGE_ME 를 실제 값으로 채운다.
#   infra/.env 는 깃에 올리지 않는다. 비밀값(키·비밀번호)은 서버 전용이고 NEXT_PUBLIC_ 변수에 넣지 않는다.
#
# GPU 호스트의 Qwen·Kev 는 SSH 터널로 노트북 localhost 에 붙인다(호스트·계정은 직접 채운다).
#   ssh -N -L 8001:127.0.0.1:8001 -L 8009:127.0.0.1:8009 <user>@<gpu-host>
# 컨테이너는 host.docker.internal 로 그 터널에 닿는다.

# 실행 모드: live. fixture 로 두면 수집만 fixture 를 쓴다(그때는 DEMO_MODE 를 확인한다).
SOL_RUN_MODE=live
DEMO_MODE=false
AI_PROVIDER=local
KEV_ENABLED=true
AI_FALLBACK_TO_MOCK=false
AI_HOSTED_APPROVED=false
KEV_ALLOW_KO_STATE=false

QWEN_BASE_URL=http://host.docker.internal:8001
QWEN_MODEL=Qwen/Qwen3.5-9B
# vLLM 의 --api-key 와 같은 값. gateway 만 읽는다.
QWEN_API_KEY=CHANGE_ME
KEV_BASE_URL=http://host.docker.internal:8009
KEV_MODEL_ID=kev-9b-v1.0
KEV_QUESTION_SET=kev-qs/v0.2
KEV_API_KEY=CHANGE_ME

# 조달청 API 서비스별 키 4개 (live 에서 모두 필수). worker 만 읽는다. 로그에 찍지 않는다.
G2B_BID_NOTICE_SERVICE_KEY=CHANGE_ME
G2B_PRE_SPEC_SERVICE_KEY=CHANGE_ME
G2B_ORDER_PLAN_SERVICE_KEY=CHANGE_ME
G2B_INDUSTRY_MASTER_SERVICE_KEY=CHANGE_ME

# Supabase 클라우드 프로젝트 (공개 URL / 서버 전용 service role)
NEXT_PUBLIC_SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# 내부 서비스 비밀번호
# REDIS_PASSWORD 는 영숫자만 사용(예: `openssl rand -hex 32`). `/`·`@`·`:`·`#`·`"`·`\` 가 들어가면 REDIS_URL 해석과 redis 설정이 깨진다.
# MinIO 사용자는 3자 이상, 비밀번호는 8자 이상.
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# 선택: 호스트 포트가 겹칠 때만 주석을 풀어 바꾼다 (항상 127.0.0.1 에만 열린다)
# REDIS_HOST_PORT=6380
# MINIO_HOST_PORT=9000
# QDRANT_HOST_PORT=6333
# AI_GATEWAY_HOST_PORT=8000
