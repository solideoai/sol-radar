# SOL RADAR 데모(mock) 환경 변수 예시. 값은 placeholder(CHANGE_ME)만 둔다.
# 사용: cp infra/env/demo.env.example infra/.env 후 CHANGE_ME 를 실제 값으로 채운다.
#   infra/.env 는 깃에 올리지 않는다. 비밀값(SUPABASE_SERVICE_ROLE_KEY·REDIS_PASSWORD·MINIO_ROOT_*)은
#   worker·인프라 서비스에만 넘기고, 브라우저 번들·NEXT_PUBLIC_ 변수에 넣지 않는다.
#   NEXT_PUBLIC_SUPABASE_URL 은 공개 값이다.

# 실행 모드: mock(기본) | fixture | live. 서로 모순이면 ai-gateway 가 기동을 거부한다.
SOL_RUN_MODE=mock
DEMO_MODE=true
AI_PROVIDER=mock
KEV_ENABLED=true
AI_HOSTED_APPROVED=false
AI_FALLBACK_TO_MOCK=false
KEV_ALLOW_KO_STATE=false

# Supabase 클라우드 프로젝트 (공개 URL / 서버 전용 service role)
NEXT_PUBLIC_SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# 내부 서비스 비밀번호 (직접 길고 무작위인 값을 만든다)
# REDIS_PASSWORD 는 영숫자만 사용(예: `openssl rand -hex 32`). `/`·`@`·`:`·`#`·`"`·`\` 가 들어가면 REDIS_URL 해석과 redis 설정이 깨진다.
# MinIO 사용자는 3자 이상, 비밀번호는 8자 이상.
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# worker 의 fixture·소스 registry 경로(FIXTURES_DIR·SOURCES_REGISTRY_FILE)는 infra/compose.yaml 이 컨테이너 안 경로로 고정한다. 여기서 바꾸지 않는다.

# 선택: 호스트 포트가 겹칠 때만 주석을 풀어 바꾼다 (항상 127.0.0.1 에만 열린다)
# REDIS_HOST_PORT=6380
# MINIO_HOST_PORT=9000
# QDRANT_HOST_PORT=6333
# AI_GATEWAY_HOST_PORT=8000
