# infra/.env.ai-gateway.local에 복사하고 권한600으로 관리한다.
# 모델 파인튜닝/반입 전에는 현재 mock 모드를 유지한다.
AI_PROVIDER=mock
AI_HOSTED_APPROVED=false
AI_FALLBACK_TO_MOCK=false
KEV_ENABLED=true
# 실제 fixture/live 전환 때에만 검증한 회사 Qwen/Bosun 자격을 추가한다.
# QWEN_BASE_URL=https://acropolissg.com/vllm/v1
# QWEN_MODEL=Qwen3.8-Flash-Next-AWQ-INT4
# QWEN_API_KEY=
# KEV_BASE_URL=검증한_HTTPS_주소
# KEV_MODEL_ID=검증한_패키지_identity
# KEV_API_KEY=
