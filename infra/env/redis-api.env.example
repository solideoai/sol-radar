# 승인 후 infra/.env.redis-api.local에 복사하고 권한600으로 관리한다.
# Compose 보간에도 필요하므로 실행 시 --env-file infra/.env.redis-api.local을 지정한다.
# 기존 Nginx /redis/는 유지한다. HTTP는127.0.0.1:6380에만 게시한다.
SOL_DEPLOYMENT_ROLE=redis-api
SOL_RADAR_REDIS_NETWORK=CHANGE_ME
NEXT_PUBLIC_SUPABASE_URL=CHANGE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
API_CURSOR_SECRET=CHANGE_ME
# openssl rand -hex 32로 생성하고 Vercel REDIS_API_TOKEN과 일치시킨다.
REDIS_API_TOKEN=CHANGE_ME
# REDIS_API_TOKEN_PREVIOUS=
# 기존 Redis의 인증 방식과 전용 network를 확인한 뒤 설정한다. HTTP URL은 금지한다.
REDIS_URL=redis://CHANGE_ME@sol-radar-redis:6379
SOL_RUN_MODE=mock
# Phase 1은 기존 readiness probe를 유지한다. Storage 전환은 다음 승인 후다.
MINIO_ENDPOINT=
AI_GATEWAY_URL=
# service role·GPU key·G2B key는 이 API 런타임에 넣지 않는다.
